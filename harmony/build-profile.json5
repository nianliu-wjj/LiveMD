{
  "app": {
    "signingConfigs": [
      // 调试签名：DevEco Studio 打开后 File > Project Structure > Signing Configs
      // 勾选 Automatically generate signature information 会自动生成 debug 签名并回填此处
    ],
    "products": [
      {
        "name": "default",
        // 与本地已安装的 HarmonyOS SDK 保持一致（DevEco Studio 26.0 内置 SDK：platformVersion 26.0.1 / API 26）
        // DevEco Studio 26 起使用纯点分版本格式（不带括号），两位主版本号必须用新格式
        "compatibleSdkVersion": "26.0.1",
        "targetSdkVersion": "26.0.1",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
