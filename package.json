{
  "name": "livemd",
  "version": "1.0.18",
  "description": "LiveMD, a desktop Markdown editor built with Tauri 2 and Vue 3",
  "keywords": [
    "LiveMD",
    "Markdown",
    "markdown",
    "md"
  ],
  "license": "MIT",
  "author": {
    "name": "nianliu-wjj",
    "email": "fire-phenix@foxmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nianliu-wjj/LiveMD.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "tauri": "tauri",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-tauri-icons": "node scripts/generate-tauri-icons.mjs",
    "import:typora-themes": "node scripts/import-typora-themes.mjs",
    "dist": "tauri build",
    "dist:win-x64": "tauri build --target x86_64-pc-windows-msvc",
    "dist:mac-x64": "tauri build --target x86_64-apple-darwin",
    "dist:mac-arm64": "tauri build --target aarch64-apple-darwin",
    "dist:linux-x64": "tauri build --target x86_64-unknown-linux-gnu",
    "dist:linux-arm64": "tauri build --target aarch64-unknown-linux-gnu",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxlint --fix . && oxfmt .",
    "test": "node --experimental-strip-types --test \"test/**/*.test.mjs\"",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm",
    "release": "genereleaselog",
    "publish": "node scripts/release.mjs",
    "update:deps": "npx taze -w && pnpm i"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/comment": "^0.19.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/lsp-client": "^6.1.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.3",
    "@svgdotjs/svg.js": "3.2.0",
    "@tauri-apps/api": "^2.12.4",
    "@vue/runtime-dom": "^3.5.19",
    "@vueuse/core": "^14.0.0",
    "animejs": "^4.5.0",
    "autodialog.js": "^0.0.9",
    "autotoast.js": "^3.0.3",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "codemirror-lang-mermaid": "^0.5.0",
    "deepmerge": "^1.5.2",
    "docx": "^9.5.1",
    "eventemitter3": "^4.0.7",
    "he": "^1.2.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.28",
    "lucide-vue-next": "^1.0.0",
    "markdownlint": "^0.42.0",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^1.3.1",
    "mermaid": "^11.10.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.5",
    "nspell": "^2.1.5",
    "parchment": "^3.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.0",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.11.0",
    "prosemirror-view": "^1.41.5",
    "quill": "^2.0.3",
    "quill-delta": "^5.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-flexible-containers": "^1.5.0",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "sql-formatter": "^15.9.0",
    "unified": "^11.0.5",
    "unist": "^0.0.1",
    "unist-util-visit": "^5.0.0",
    "uuid": "^9.0.1",
    "vditor": "^3.11.2",
    "vite-auto-i18n-plugin": "^1.1.12",
    "vue": "^3.5.19",
    "vue-color": "^3.3.1",
    "vue-draggable-plus": "^0.6.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/he": "^1.2.3",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "dictionary-en": "^4.0.0",
    "genereleaselog": "^0.0.5",
    "happy-dom": "20.14.5",
    "less": "^4.4.1",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.12.0",
    "playwright": "1.49.1",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,json}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=20.17.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "pnpm": {
    "overrides": {
      "@codemirror/state": "^6.5.2",
      "@codemirror/view": "^6.38.1",
      "@lezer/highlight": "^1.2.3",
      "@lezer/common": "^1.5.0",
      "@codemirror/language": "^6.12.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ]
  },
  "build": {
    "appId": "io.github.nianliu-wjj.livemd",
    "productName": "LiveMD",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "icon": "src/assets/icons/livemd",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown File",
        "role": "Editor",
        "icon": "src/assets/icons/file"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
